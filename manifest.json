{
  "manifest_version": 3,
  "name": "PasteFilter — Redact & Randomize Sensitive Data",
  "short_name": "PasteFilter",
  "version": "1.0.0",
  "description": "Detect API keys, passwords & personal data as you paste — block, mask, or swap in realistic fake data. 100% local, no tracking.",
  "author": "SEOULTRA",
  "homepage_url": "https://seoultra.id/plugins/",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "PasteFilter",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/config.js", "src/detectors.js", "src/fake.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
